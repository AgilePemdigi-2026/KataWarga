# ==============================================================================
# KataWarga Environment Variables Template
# Salin file ini menjadi .env dan sesuaikan dengan konfigurasi lokal Anda:
#   cp .env.example .env
# ==============================================================================

# Django Core
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=django-insecure-change-this-key-in-production-katawarga-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
DB_NAME=katawarga
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
# Port di laptop (dipetakan ke 5432 di container, lihat docker-compose.yml)
DB_PORT=5433

# Stub Peran untuk Development (§4 Project Context: Sprint 1-2 sebelum Auth jadi)
# Pilihan: REQUIREMENTS_ENGINEER, ANALYST, PRODUCT_OWNER, TIM_DEVELOPER
DEV_ACTING_ROLE=REQUIREMENTS_ENGINEER

# Gemini API (Sprint 3). Buat kunci gratis di https://aistudio.google.com/apikey
# JANGAN commit nilai asli. File .env sudah masuk .gitignore.
GEMINI_API_KEY=
# Nama model: cek di AI Studio. Contoh: gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash
# Samakan dengan kuota free tier di dashboard AI Studio (permintaan per menit)
GEMINI_RPM=10
GEMINI_TIMEOUT=60
GEMINI_MAX_RETRY=4

# LLM kampus (opsional; server Aorus, kompatibel OpenAI). Hanya terjangkau dari aplikasi yang di-deploy di server.
# Pakai dengan: python manage.py extract_reviews --extractor kampus
LLM_BASE_URL=
LLM_API_KEY=ollama
LLM_MODEL=gemma4:12b
LLM_TIMEOUT=180
LLM_BATCH=15
# Kosong = server belum punya model embedding. Isi bila dosen memasangnya, lalu EMBED_PROVIDER=kampus
LLM_EMBED_MODEL=
EMBED_PROVIDER=gemini
